{
  "name": "emocode-v3.1",
  "version": "3.1.0",
  "desktopName": "emocode-v3.1.desktop",
  "description": "OpenRouter tabanlı, kademeli izin yönetimli masaüstü kodlama ajanı (emocode v3.1)",
  "author": {
    "name": "Emo"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=65 --test-coverage-include=main.js --test-coverage-include=preload.js --test-coverage-include=lib/*.js --test \"test/*.test.js\"",
    "test:ui": "node scripts/test-ui.mjs",
    "test:windows": "node --test test/main.test.js test/renderer.test.js test/security.test.js test/attachments.test.js",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "LANG=C.UTF-8 LC_ALL=C.UTF-8 electron-builder --win portable"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "12.0.2"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.emo.code.v3",
    "productName": "emocode v3.1",
    "artifactName": "emocode-v3.1.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "synopsis": "OpenRouter tabanlı masaüstü kodlama ajanı"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    }
  }
}
